<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="EllieAccentBrush" Color="#FFDCAE96" />
            <SolidColorBrush x:Key="EllieAccentSubtleBrush" Color="#33DCAE96" />
            <SolidColorBrush x:Key="EllieToolbarBackgroundBrush" Color="#E62B2B2B" />
            <SolidColorBrush x:Key="EllieSelectedStateBrush" Color="#4D60CDFF" />
            <SolidColorBrush x:Key="EllieSelectedBorderBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="EllieSidebarBackgroundBrush" Color="#F22B2B2B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EllieAccentBrush" Color="#FF9B4F2E" />
            <SolidColorBrush x:Key="EllieAccentSubtleBrush" Color="#339B4F2E" />
            <SolidColorBrush x:Key="EllieToolbarBackgroundBrush" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="EllieSelectedStateBrush" Color="#334A90E2" />
            <SolidColorBrush x:Key="EllieSelectedBorderBrush" Color="#FF005FB8" />
            <SolidColorBrush x:Key="EllieSidebarBackgroundBrush" Color="#FAFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EllieAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EllieAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EllieToolbarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EllieSelectedStateBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EllieSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="EllieSidebarBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="EllieAccentButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource EllieAccentBrush}" />
    </Style>

    <Style x:Key="EllieToolbarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EllieToolbarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style x:Key="EllieEditToolbarBorderStyle" BasedOn="{StaticResource EllieToolbarBorderStyle}" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource EllieAccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <Style x:Key="EllieReaderCommandBarStyle" TargetType="CommandBar">
        <Setter Property="Background" Value="{ThemeResource EllieToolbarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="DefaultLabelPosition" Value="Collapsed" />
        <Setter Property="IsDynamicOverflowEnabled" Value="True" />
        <Setter Property="MaxWidth" Value="960" />
    </Style>

    <Style x:Key="EllieTouchButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style
        x:Key="EllieSubtleTouchButtonStyle"
        BasedOn="{StaticResource SubtleButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
    </Style>

    <Style x:Key="ElliePaletteButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="3" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>
</ResourceDictionary>
