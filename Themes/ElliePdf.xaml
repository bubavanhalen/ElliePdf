<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="EllieAccentColor">#DCAE96</Color>
    <SolidColorBrush x:Key="EllieAccentBrush" Color="{StaticResource EllieAccentColor}" />
    <SolidColorBrush x:Key="EllieAccentSubtleBrush" Color="#33DCAE96" />

    <Style x:Key="EllieAccentButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource EllieAccentBrush}" />
    </Style>

    <Style x:Key="EllieToolbarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Opacity" Value="0.96" />
    </Style>

    <Style x:Key="EllieEditToolbarBorderStyle" BasedOn="{StaticResource EllieToolbarBorderStyle}" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource EllieAccentBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
</ResourceDictionary>
