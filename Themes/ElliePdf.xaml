<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="EllieAccentColor">#5B5CE2</Color>
            <Color x:Key="EllieAccentHoverColor">#4C4DCC</Color>
            <SolidColorBrush x:Key="EllieAccentBrush" Color="#5B5CE2" />
            <SolidColorBrush x:Key="EllieAccentHoverBrush" Color="#4C4DCC" />
            <SolidColorBrush x:Key="EllieAccentSubtleBrush" Color="#EAEAFE" />
            <SolidColorBrush x:Key="EllieCanvasBrush" Color="#F1F2F6" />
            <SolidColorBrush x:Key="EllieShellBrush" Color="#FBFBFD" />
            <SolidColorBrush x:Key="EllieSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EllieSurfaceSecondaryBrush" Color="#F7F7FA" />
            <SolidColorBrush x:Key="EllieSurfaceHoverBrush" Color="#F0F0F6" />
            <SolidColorBrush x:Key="EllieBorderBrush" Color="#DDDDE7" />
            <SolidColorBrush x:Key="EllieBorderStrongBrush" Color="#C8C8D6" />
            <SolidColorBrush x:Key="EllieTextSecondaryBrush" Color="#666675" />
            <SolidColorBrush x:Key="EllieTextTertiaryBrush" Color="#8A8A99" />
            <SolidColorBrush x:Key="EllieSuccessBrush" Color="#16805A" />
            <SolidColorBrush x:Key="EllieDropZoneBrush" Color="#F8F8FF" />
            <ThemeShadow x:Key="EllieCardShadow" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Color x:Key="EllieAccentColor">#8B8CF8</Color>
            <Color x:Key="EllieAccentHoverColor">#A5A6FF</Color>
            <SolidColorBrush x:Key="EllieAccentBrush" Color="#8B8CF8" />
            <SolidColorBrush x:Key="EllieAccentHoverBrush" Color="#A5A6FF" />
            <SolidColorBrush x:Key="EllieAccentSubtleBrush" Color="#303052" />
            <SolidColorBrush x:Key="EllieCanvasBrush" Color="#17171B" />
            <SolidColorBrush x:Key="EllieShellBrush" Color="#202025" />
            <SolidColorBrush x:Key="EllieSurfaceBrush" Color="#27272D" />
            <SolidColorBrush x:Key="EllieSurfaceSecondaryBrush" Color="#2D2D34" />
            <SolidColorBrush x:Key="EllieSurfaceHoverBrush" Color="#36363F" />
            <SolidColorBrush x:Key="EllieBorderBrush" Color="#3C3C46" />
            <SolidColorBrush x:Key="EllieBorderStrongBrush" Color="#50505C" />
            <SolidColorBrush x:Key="EllieTextSecondaryBrush" Color="#B8B8C5" />
            <SolidColorBrush x:Key="EllieTextTertiaryBrush" Color="#9494A3" />
            <SolidColorBrush x:Key="EllieSuccessBrush" Color="#4FD1A0" />
            <SolidColorBrush x:Key="EllieDropZoneBrush" Color="#22222B" />
            <ThemeShadow x:Key="EllieCardShadow" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Color x:Key="EllieAccentColor">#FFFF00</Color>
            <Color x:Key="EllieAccentHoverColor">#FFFF00</Color>
            <SolidColorBrush x:Key="EllieAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EllieAccentHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EllieAccentSubtleBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EllieCanvasBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EllieShellBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EllieSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EllieSurfaceSecondaryBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EllieSurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EllieBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EllieBorderStrongBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EllieTextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EllieTextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EllieSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EllieDropZoneBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <ThemeShadow x:Key="EllieCardShadow" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="EllieAccentButtonStyle" BasedOn="{StaticResource AccentButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource EllieAccentBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="16,8" />
    </Style>

    <Style x:Key="EllieSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource EllieSurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EllieBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="14,7" />
    </Style>

    <Style x:Key="EllieIconButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="EllieCommandBarButtonStyle" TargetType="AppBarButton">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="EllieToolToggleStyle" TargetType="AppBarToggleButton">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="ElliePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EllieSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EllieBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style x:Key="EllieToolbarBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource EllieSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource EllieBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Shadow" Value="{ThemeResource EllieCardShadow}" />
    </Style>

    <Style x:Key="EllieEditToolbarBorderStyle" BasedOn="{StaticResource EllieToolbarBorderStyle}" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource EllieAccentBrush}" />
    </Style>
</ResourceDictionary>
