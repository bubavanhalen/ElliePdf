<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,24,32,32">
        <StackPanel MaxWidth="640" Spacing="20">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Settings" />

            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

            <StackPanel Spacing="16">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Reading" />

                <ComboBox
                    Header="Default zoom when opening a PDF"
                    ItemsSource="{x:Bind ViewModel.ZoomModeOptions, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.DefaultZoomMode, Mode=TwoWay}" />

                <NumberBox
                    Header="Recent files to remember"
                    Maximum="50"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{x:Bind ViewModel.RecentFilesMaxCount, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Spacing="16">
                <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Saving" />

                <ToggleSwitch
                    Header="Confirm before overwriting a PDF when saving edits"
                    IsOn="{x:Bind ViewModel.ConfirmOverwriteSave, Mode=TwoWay}" />

                <ToggleSwitch
                    Header="Confirm before saving changes back to original files in Organize"
                    IsOn="{x:Bind ViewModel.ConfirmOrganizeSave, Mode=TwoWay}" />

            </StackPanel>

            <Button
                HorizontalAlignment="Left"
                Command="{x:Bind ViewModel.SaveCommand}"
                Content="Save settings"
                Style="{StaticResource EllieAccentButtonStyle}" />
        </StackPanel>
    </ScrollViewer>
</Page>
