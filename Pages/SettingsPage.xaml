<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <ScrollViewer Padding="32,60,32,32">
        <StackPanel MaxWidth="720" Spacing="8">
            <TextBlock
                Margin="0,0,0,8"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Settings" />

            <!--  Appearance  -->
            <TextBlock Style="{StaticResource EllieSectionHeaderStyle}" Text="Appearance" />
            <Border Style="{StaticResource EllieSettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource EllieIconWellStyle}" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource EllieAccentStrongBrush}"
                            Glyph="&#xE790;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="App theme" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Changes apply immediately" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="180"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!--  Reading  -->
            <TextBlock Style="{StaticResource EllieSectionHeaderStyle}" Text="Reading" />
            <Border Style="{StaticResource EllieSettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource EllieIconWellStyle}" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource EllieAccentStrongBrush}"
                            Glyph="&#xE736;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Default zoom" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Used when a PDF is opened" />
                    </StackPanel>
                    <ComboBox
                        Grid.Column="2"
                        MinWidth="180"
                        ItemsSource="{x:Bind ViewModel.ZoomModeOptions}"
                        SelectedIndex="{x:Bind ViewModel.DefaultZoomModeIndex, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource EllieSettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource EllieIconWellStyle}" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource EllieAccentStrongBrush}"
                            Glyph="&#xE823;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Recent files" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="How many recent files to remember" />
                    </StackPanel>
                    <NumberBox
                        Grid.Column="2"
                        MinWidth="140"
                        Maximum="50"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.RecentFilesMaxCount, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!--  Saving  -->
            <TextBlock Style="{StaticResource EllieSectionHeaderStyle}" Text="Saving" />
            <Border Style="{StaticResource EllieSettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource EllieIconWellStyle}" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource EllieAccentStrongBrush}"
                            Glyph="&#xE74E;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Confirm before overwriting" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Ask before saving edits over the original PDF" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.ConfirmOverwriteSave, Mode=TwoWay}"
                        OffContent=""
                        OnContent=""
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource EllieSettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource EllieIconWellStyle}" VerticalAlignment="Center">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource EllieAccentStrongBrush}"
                            Glyph="&#xE8A9;" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Confirm Organize saves" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Ask before saving changes back to original files in Organize" />
                    </StackPanel>
                    <ToggleSwitch
                        Grid.Column="2"
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.ConfirmOrganizeSave, Mode=TwoWay}"
                        OffContent=""
                        OnContent=""
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
            <!--  About  -->
            <TextBlock Style="{StaticResource EllieSectionHeaderStyle}" Text="About" />
            <Border Style="{StaticResource EllieSettingsCardStyle}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image
                        Width="36"
                        Height="36"
                        Source="ms-appx:///Assets/Brand/elliepdf-logo-master.png"
                        VerticalAlignment="Center" />
                    <StackPanel
                        Grid.Column="1"
                        Spacing="2"
                        VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="ElliePdf" />
                        <TextBlock
                            Opacity="0.6"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Built with WinUI 3 and PDFium" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="2"
                        Opacity="0.6"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.AppVersion}"
                        VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
