<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ElliePdf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:ElliePdf.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ElliePdf.ViewModels"
    AllowDrop="True"
    DragOver="ReaderPage_DragOver"
    Drop="ReaderPage_Drop"
    FlowDirection="{x:Bind UiFlowDirection, Mode=OneTime}"
    KeyDown="ReaderPage_KeyDown"
    SizeChanged="ReaderPage_SizeChanged"
    mc:Ignorable="d">

    <Page.Resources>
        <ContentDialog
            x:Name="SignatureDialog"
            x:Uid="Reader_SignatureDialog"
            AutomationProperties.AutomationId="SignatureDialog">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Padding="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    CornerRadius="4">
                    <Canvas
                        x:Name="SignatureCanvas"
                        x:Uid="Reader_SignatureCanvas"
                        Width="400"
                        Height="200"
                        AutomationProperties.AutomationId="SignatureCanvas" />
                </Border>
                <TextBox
                    x:Name="SignatureNameBox"
                    x:Uid="Reader_SignatureName"
                    Grid.Row="1"
                    MinHeight="44"
                    Margin="0,8,0,0" />
                <Button
                    x:Name="BtnClearSignature"
                    x:Uid="Reader_ClearSignature"
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="BtnClearSignature"
                    Style="{StaticResource EllieTouchButtonStyle}" />
            </Grid>
        </ContentDialog>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="Transparent"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        PointerMoved="RootGrid_PointerMoved">

        <controls:PdfPageViewer
            x:Name="PageViewer"
            Margin="56,48,56,0"
            Canvas.ZIndex="0"
            AutomationProperties.Name="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
            ContentBottomInset="112"
            DisplayScale="{x:Bind ViewModel.DisplayScale, Mode=OneWay}"
            IsChromeless="True"
            IsTabStop="True"
            IsOverlayEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
            PageHeightPoints="{x:Bind ViewModel.PageHeightPoints, Mode=OneWay}"
            PageDisplayHeight="{x:Bind ViewModel.PagePixelHeight, Mode=OneWay}"
            PageDisplayWidth="{x:Bind ViewModel.PagePixelWidth, Mode=OneWay}"
            PageTiles="{x:Bind ViewModel.PageTiles, Mode=OneWay}"
            SemanticPage="{x:Bind ViewModel.CurrentSemanticPage, Mode=OneWay}"
            CanCopy="{x:Bind ViewModel.CanCopy, Mode=OneWay}"
            LinkInvoked="SemanticOverlay_LinkInvoked"
            FormValueCommitted="SemanticOverlay_FormValueCommitted"
            PushButtonInvoked="SemanticOverlay_PushButtonInvoked"
            SearchHighlights="{x:Bind ViewModel.SearchHighlights, Mode=OneWay}"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowSinglePageViewer), Mode=OneWay}" />

        <ScrollViewer
            x:Name="ContinuousScrollViewer"
            Margin="56,0,56,0"
            Canvas.ZIndex="0"
            AutomationProperties.Name="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            IsTabStop="True"
            PointerPressed="ContinuousScrollViewer_PointerPressed"
            PointerWheelChanged="ContinuousScrollViewer_PointerWheelChanged"
            SizeChanged="ContinuousScrollViewer_SizeChanged"
            VerticalAnchorRatio="0.5"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            ViewChanged="ContinuousScrollViewer_ViewChanged"
            ZoomMode="Disabled"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowContinuousViewer), Mode=OneWay}">
            <ItemsRepeater
                x:Name="ContinuousPagesItems"
                Margin="0,24,0,112"
                ElementClearing="ContinuousPagesItems_ElementClearing"
                ElementPrepared="ContinuousPagesItems_ElementPrepared"
                ItemsSource="{x:Bind ViewModel.ContinuousPages, Mode=OneWay}"
                VerticalCacheLength="0">
                <ItemsRepeater.Layout>
                    <controls:IndexedPageLayout />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:RenderedPageViewModel">
                        <Grid
                            Width="{x:Bind PixelWidth, Mode=OneWay}"
                            Height="{x:Bind PixelHeight, Mode=OneWay}"
                            MinHeight="44"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}">
                            <controls:PdfPagePresenter
                                CanCopy="{x:Bind CanCopy, Mode=OneWay}"
                                DisplayScale="{x:Bind DisplayScale, Mode=OneWay}"
                                FormValueCommitted="SemanticOverlay_FormValueCommitted"
                                LinkInvoked="SemanticOverlay_LinkInvoked"
                                PushButtonInvoked="SemanticOverlay_PushButtonInvoked"
                                PageHeightPoints="{x:Bind PageHeightPoints, Mode=OneWay}"
                                PageTiles="{x:Bind Tiles, Mode=OneWay}"
                                SemanticPage="{x:Bind SemanticPage, Mode=OneWay}"
                                SearchHighlights="{x:Bind SearchHighlights, Mode=OneWay}" />
                            <ProgressRing
                                HorizontalAlignment="Center"
                                IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(IsLoading), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>

        <!--  ═══════════ Empty state ═══════════  -->
        <ScrollViewer
            Canvas.ZIndex="5"
            Padding="48,72,48,24"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowEmptyState), Mode=OneWay}">
            <StackPanel
                MaxWidth="620"
                HorizontalAlignment="Center"
                Spacing="24"
                VerticalAlignment="Center">
                <TextBlock
                    x:Uid="Reader_EmptyStateTitle"
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button
                    x:Name="EmptyStateOpenButton"
                    x:Uid="Reader_EmptyStateOpen"
                    HorizontalAlignment="Center"
                    Click="OpenFileButton_Click"
                    AutomationProperties.AcceleratorKey="Ctrl+O"
                    Style="{StaticResource EllieTouchButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <SymbolIcon Symbol="OpenFile" />
                        <TextBlock x:Uid="Reader_OpenPdfText" />
                    </StackPanel>
                </Grid>

                <!--  Recent files  -->
                <StackPanel Spacing="8" Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowRecentFiles), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Opacity="0.7"
                            Glyph="&#xE823;" />
                        <TextBlock Style="{StaticResource EllieSectionHeaderStyle}" Text="Recent" Margin="0" />
                    </StackPanel>
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="RecentFiles_ItemClick"
                        ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentFileItemViewModel">
                                <Border
                                    Width="284"
                                    Padding="12,10"
                                    Style="{StaticResource EllieCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource EllieIconWellStyle}" VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{ThemeResource EllieAccentStrongBrush}"
                                                Glyph="&#xE8A5;" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind FolderName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Unified responsive sidebar: docked at >=1000 epx, overlay below it. -->
        <Border
            x:Name="ReaderSidebar"
            x:Uid="Reader_Sidebar"
            Width="320"
            Margin="0,0,0,92"
            Canvas.ZIndex="10"
            HorizontalAlignment="Left"
            AutomationProperties.AutomationId="ReaderSidebar"
            Background="{ThemeResource EllieSidebarBackgroundBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsSidebarOpen), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="12,6,6,6" MinHeight="56">
                    <TextBlock
                        x:Name="SidebarHeading"
                        x:Uid="Reader_SidebarHeading"
                        Margin="0,0,52,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Button
                        x:Name="CloseSidebarButton"
                        x:Uid="Reader_CloseSidebar"
                        Width="44"
                        Height="44"
                        HorizontalAlignment="Right"
                        AutomationProperties.AcceleratorKey="Escape"
                        Click="CloseSidebarButton_Click"
                        Style="{StaticResource SubtleButtonStyle}">
                        <SymbolIcon Symbol="Cancel" />
                    </Button>
                </Grid>

                <Grid
                    x:Uid="Reader_ThumbnailsPanel"
                    Grid.Row="1"
                    Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsThumbnailPanelOpen), Mode=OneWay}">
                    <GridView
                        x:Name="PageThumbnails"
                        Padding="8"
                        IsItemClickEnabled="True"
                        ItemClick="PageThumbnails_ItemClick"
                        ItemsSource="{x:Bind ViewModel.PageThumbnails, Mode=OneWay}"
                        ContainerContentChanging="PageThumbnails_ContainerContentChanging"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageThumbnailViewModel">
                                <StackPanel
                                    Width="96"
                                    MinHeight="148"
                                    AutomationProperties.ItemStatus="{x:Bind SelectionStatus, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
                                    Spacing="4">
                                    <Grid Height="116">
                                        <ProgressRing
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                            Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                        <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                                    </Grid>
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Text="{x:Bind SelectionGlyph, Mode=OneWay}" />
                                        <TextBlock
                                            Opacity="0.8"
                                            Style="{StaticResource CaptionTextBlockStyle}"
                                            Text="{x:Bind Label, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </Grid>

                <Grid
                    x:Uid="Reader_OutlinePanel"
                    Grid.Row="1"
                    Padding="12,0,12,8"
                    Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsOutlinePanelOpen), Mode=OneWay}">
                    <ListView
                        x:Name="OutlineItems"
                        IsItemClickEnabled="True"
                        ItemClick="OutlineItems_ItemClick"
                        ItemsSource="{x:Bind ViewModel.OutlineItems, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:OutlineItemViewModel">
                                <TextBlock
                                    MinHeight="44"
                                    Margin="{x:Bind IndentMargin, Mode=OneWay}"
                                    Padding="8,10"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="16,0,16,16"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsSearchPanelOpen), Mode=OneWay}">
                    <StackPanel Spacing="12" VerticalAlignment="Top">
                        <TextBox
                            x:Name="SearchBox"
                            x:Uid="Reader_SearchBox"
                            MinHeight="44"
                            AutomationProperties.AcceleratorKey="Ctrl+F"
                            KeyDown="SearchBox_KeyDown"
                            Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            x:Uid="Reader_MatchCase"
                            MinHeight="44"
                            IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
                        <StackPanel Spacing="8">
                            <Button x:Uid="Reader_Find" Command="{x:Bind ViewModel.SearchCommand}" Style="{StaticResource EllieTouchButtonStyle}" />
                            <Button x:Uid="Reader_PreviousMatch" Command="{x:Bind ViewModel.PreviousSearchMatchCommand}" Style="{StaticResource EllieTouchButtonStyle}" />
                            <Button x:Uid="Reader_NextMatch" Command="{x:Bind ViewModel.NextSearchMatchCommand}" Style="{StaticResource EllieTouchButtonStyle}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SearchStatus"
                            AutomationProperties.LiveSetting="Polite"
                            Opacity="0.8"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                            TextWrapping="WrapWholeWords" />
                        <ListView
                            x:Name="SearchResultsList"
                            IsItemClickEnabled="True"
                            ItemClick="SearchResults_ItemClick"
                            ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                            SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchResultItemViewModel">
                                    <StackPanel
                                        MinHeight="44"
                                        Padding="8,6"
                                        AutomationProperties.Name="{x:Bind AutomationName, Mode=OneTime}">
                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind PageLabel, Mode=OneTime}" />
                                        <TextBlock
                                            MaxLines="3"
                                            Opacity="0.8"
                                            Text="{x:Bind Context, Mode=OneTime}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Slim tab strip: only when multiple documents are open -->
        <TabView
            x:Name="DocumentTabs"
            x:Uid="Reader_DocumentTabs"
            Margin="104,4,260,0"
            Canvas.ZIndex="20"
            VerticalAlignment="Top"
            AddTabButtonClick="DocumentTabs_AddTabButtonClick"
            Background="Transparent"
            CanDragTabs="True"
            CanReorderTabs="True"
            IsAddTabButtonVisible="True"
            TabCloseRequested="DocumentTabs_TabCloseRequested"
            TabWidthMode="SizeToContent"
            SelectionChanged="DocumentTabs_SelectionChanged"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowTabBar), Mode=OneWay}" />

        <!-- Responsive reader commands. Dynamic overflow keeps primary operations reachable at 500 epx. -->
        <CommandBar
            x:Name="ReaderCommandBar"
            x:Uid="Reader_CommandBar"
            Margin="12"
            Canvas.ZIndex="30"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            AutomationProperties.AutomationId="ReaderCommandBar"
            Style="{StaticResource EllieReaderCommandBarStyle}"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowReadToolbar), Mode=OneWay}">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    x:Name="OpenCommandButton"
                    x:Uid="Reader_Open"
                    AutomationProperties.AcceleratorKey="Ctrl+O"
                    Click="OpenFileButton_Click"
                    DynamicOverflowOrder="6"
                    Icon="OpenFile"
                    KeyboardAcceleratorTextOverride="Ctrl+O" />
                <AppBarButton
                    x:Name="PreviousPageButton"
                    x:Uid="Reader_PreviousPage"
                    AutomationProperties.AcceleratorKey="Page Up"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    DynamicOverflowOrder="1"
                    Icon="Back"
                    KeyboardAcceleratorTextOverride="Page Up" />
                <AppBarElementContainer DynamicOverflowOrder="0">
                    <TextBox
                        x:Name="PageNumberBox"
                        x:Uid="Reader_PageNumber"
                        Width="112"
                        MinHeight="44"
                        HorizontalContentAlignment="Center"
                        AutomationProperties.AcceleratorKey="Ctrl+G"
                        KeyDown="PageNumberBox_KeyDown"
                        LostFocus="PageNumberBox_LostFocus"
                        Text="{x:Bind ViewModel.CurrentPageNumberText, Mode=OneWay}"
                        TextAlignment="Center" />
                </AppBarElementContainer>
                <AppBarButton
                    x:Name="NextPageButton"
                    x:Uid="Reader_NextPage"
                    AutomationProperties.AcceleratorKey="Page Down"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    DynamicOverflowOrder="2"
                    Icon="Forward"
                    KeyboardAcceleratorTextOverride="Page Down" />
                <AppBarToggleButton
                    x:Name="SearchCommandButton"
                    x:Uid="Reader_Search"
                    AutomationProperties.AcceleratorKey="Ctrl+F"
                    Click="SearchCommandButton_Click"
                    DynamicOverflowOrder="3"
                    Icon="Find"
                    IsChecked="{x:Bind ViewModel.IsSearchPanelOpen, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="Ctrl+F" />
                <AppBarButton
                    x:Uid="Reader_ZoomOut"
                    AutomationProperties.AcceleratorKey="Ctrl+-"
                    Command="{x:Bind ViewModel.ZoomOutCommand}"
                    DynamicOverflowOrder="4"
                    Icon="ZoomOut"
                    KeyboardAcceleratorTextOverride="Ctrl+-" />
                <AppBarElementContainer DynamicOverflowOrder="5">
                    <TextBlock
                        MinWidth="56"
                        HorizontalAlignment="Center"
                        AutomationProperties.Name="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}"
                        TextAlignment="Center" />
                </AppBarElementContainer>
                <AppBarButton
                    x:Uid="Reader_ZoomIn"
                    AutomationProperties.AcceleratorKey="Ctrl++"
                    Command="{x:Bind ViewModel.ZoomInCommand}"
                    DynamicOverflowOrder="5"
                    Icon="ZoomIn"
                    KeyboardAcceleratorTextOverride="Ctrl++" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    x:Uid="Reader_CloseDocument"
                    AutomationProperties.AcceleratorKey="Ctrl+W"
                    Click="CloseDocumentButton_Click"
                    Icon="Cancel"
                    KeyboardAcceleratorTextOverride="Ctrl+W" />
                <AppBarToggleButton
                    x:Uid="Reader_Pages"
                    Click="PagesCommandButton_Click"
                    Icon="ViewAll"
                    IsChecked="{x:Bind ViewModel.IsThumbnailPanelOpen, Mode=OneWay}" />
                <AppBarToggleButton
                    x:Uid="Reader_Outline"
                    Click="OutlineCommandButton_Click"
                    Icon="Library"
                    IsChecked="{x:Bind ViewModel.IsOutlinePanelOpen, Mode=OneWay}" />
                <AppBarButton x:Uid="Reader_ViewMode" Icon="ViewAll">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <RadioMenuFlyoutItem
                                x:Uid="Reader_ContinuousView"
                                Command="{x:Bind ViewModel.UseContinuousViewCommand}"
                                GroupName="ReaderViewMode"
                                IsChecked="{x:Bind ViewModel.IsContinuousView, Mode=OneWay}" />
                            <RadioMenuFlyoutItem
                                x:Uid="Reader_SinglePageView"
                                Command="{x:Bind ViewModel.UseSinglePageViewCommand}"
                                GroupName="ReaderViewMode"
                                IsChecked="{x:Bind ViewModel.IsSinglePageView, Mode=OneWay}" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton x:Uid="Reader_FitWidth" Command="{x:Bind ViewModel.ZoomFitWidthCommand}" Icon="FullScreen" />
                <AppBarButton x:Uid="Reader_FitPage" Command="{x:Bind ViewModel.ZoomFitPageCommand}" Icon="View" />
                <AppBarButton x:Uid="Reader_ActualSize" Command="{x:Bind ViewModel.ZoomActualSizeCommand}" Icon="Zoom" />
                <AppBarButton x:Uid="Reader_Properties" Click="PropertiesButton_Click" Icon="Document" />
                <AppBarButton
                    x:Name="PrintCommandButton"
                    x:Uid="Reader_Print"
                    AutomationProperties.AcceleratorKey="Ctrl+P"
                    Click="PrintButton_Click"
                    Icon="Print"
                    IsEnabled="False"
                    KeyboardAcceleratorTextOverride="Ctrl+P" />
                <AppBarButton
                    x:Uid="Reader_Organize"
                    Command="{x:Bind ViewModel.OpenOrganizeCommand}"
                    Icon="Library"
                    Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsLabsEnabled), Mode=OneWay}" />
                <AppBarButton
                    x:Uid="Reader_Edit"
                    Command="{x:Bind ViewModel.EnterEditModeCommand}"
                    Icon="Edit"
                    Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsLabsEnabled), Mode=OneWay}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!-- Floating edit tools -->
        <CommandBar
            x:Name="EditCommandBar"
            x:Uid="Reader_EditCommandBar"
            Margin="12"
            Canvas.ZIndex="30"
            HorizontalAlignment="Stretch"
            AutomationProperties.AutomationId="EditCommandBar"
            Style="{StaticResource EllieReaderCommandBarStyle}"
            VerticalAlignment="Bottom"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowEditToolbar), Mode=OneWay}">
            <CommandBar.PrimaryCommands>
                <AppBarButton
                    x:Uid="Reader_DoneEditing"
                    Command="{x:Bind ViewModel.ExitEditModeCommand}"
                    DynamicOverflowOrder="0"
                    Icon="Accept" />
                <AppBarButton
                    x:Uid="Reader_Save"
                    AutomationProperties.AcceleratorKey="Ctrl+S"
                    Click="SaveButton_Click"
                    DynamicOverflowOrder="1"
                    Icon="Save"
                    IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                    KeyboardAcceleratorTextOverride="Ctrl+S" />
                <AppBarButton
                    x:Uid="Reader_SaveAs"
                    AutomationProperties.AcceleratorKey="Ctrl+Shift+S"
                    Click="SaveAsButton_Click"
                    DynamicOverflowOrder="2"
                    Icon="Copy"
                    KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
                <AppBarToggleButton
                    x:Uid="Reader_SelectTool"
                    Command="{x:Bind ViewModel.UseSelectToolCommand}"
                    DynamicOverflowOrder="3"
                    Icon="TouchPointer"
                    IsChecked="{x:Bind ViewModel.IsSelectToolActive, Mode=OneWay}" />
                <AppBarToggleButton
                    x:Name="InkToolButton"
                    x:Uid="Reader_InkTool"
                    Command="{x:Bind ViewModel.UseInkToolCommand}"
                    Click="InkToolButton_Click"
                    DynamicOverflowOrder="4"
                    Icon="Edit"
                    IsChecked="{x:Bind ViewModel.IsInkToolActive, Mode=OneWay}" />
                <AppBarButton
                    x:Uid="Reader_AddText"
                    Click="AddTextButton_Click"
                    DynamicOverflowOrder="5"
                    Icon="Font"
                    KeyboardAcceleratorTextOverride="T">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="T" Invoked="AddTextKeyboardAccelerator_Invoked" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    x:Uid="Reader_Signature"
                    Click="SignatureButton_Click"
                    DynamicOverflowOrder="6"
                    Icon="Contact"
                    KeyboardAcceleratorTextOverride="Shift+S">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator Key="S" Modifiers="Shift" Invoked="SignatureKeyboardAccelerator_Invoked" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarToggleButton
                    x:Uid="Reader_Eraser"
                    Command="{x:Bind ViewModel.UseEraserToolCommand}"
                    DynamicOverflowOrder="7"
                    Icon="Clear"
                    IsChecked="{x:Bind ViewModel.IsEraserToolActive, Mode=OneWay}" />
            </CommandBar.PrimaryCommands>
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    x:Uid="Reader_UndoEdit"
                    AutomationProperties.AcceleratorKey="Ctrl+Z"
                    Click="UndoEditButton_Click"
                    Icon="Undo"
                    KeyboardAcceleratorTextOverride="Ctrl+Z" />
                <AppBarButton
                    x:Uid="Reader_DeleteEdit"
                    AutomationProperties.AcceleratorKey="Delete"
                    Click="DeleteEditButton_Click"
                    Icon="Delete"
                    KeyboardAcceleratorTextOverride="Delete" />
                <AppBarButton
                    x:Uid="Reader_PreviousPage"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Icon="Back"
                    KeyboardAcceleratorTextOverride="Page Up" />
                <AppBarButton
                    x:Uid="Reader_NextPage"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Icon="Forward"
                    KeyboardAcceleratorTextOverride="Page Down" />
                <AppBarButton
                    x:Uid="Reader_FitWidth"
                    Command="{x:Bind ViewModel.ZoomFitWidthCommand}"
                    Icon="FullScreen" />
                <AppBarButton
                    x:Uid="Reader_ZoomOut"
                    Command="{x:Bind ViewModel.ZoomOutCommand}"
                    Icon="ZoomOut"
                    KeyboardAcceleratorTextOverride="Ctrl+-" />
                <AppBarButton
                    x:Uid="Reader_ZoomIn"
                    Command="{x:Bind ViewModel.ZoomInCommand}"
                    Icon="ZoomIn"
                    KeyboardAcceleratorTextOverride="Ctrl++" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <!--  Ink palette  -->
        <Popup
            x:Name="InkPalettePopup"
            Canvas.ZIndex="40"
            IsLightDismissEnabled="True">
            <Border
                x:Name="InkPalette"
                Padding="10,8"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Opacity="0.98">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        x:Uid="Reader_InkPaletteLabel"
                        Margin="2,0,4,0"
                        Opacity="0.75"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <Button
                        x:Name="InkBlackButton"
                        x:Uid="Reader_InkBlack"
                        Click="InkColorSwatch_Click"
                        Style="{StaticResource ElliePaletteButtonStyle}"
                        Tag="#000000"
                        AutomationProperties.ItemStatus="Not selected">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="Black" />
                    </Button>
                    <Button
                        x:Name="InkRedButton"
                        x:Uid="Reader_InkRed"
                        Click="InkColorSwatch_Click"
                        Style="{StaticResource ElliePaletteButtonStyle}"
                        Tag="#B3261E"
                        AutomationProperties.ItemStatus="Not selected">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="#B3261E" />
                    </Button>
                    <Button
                        x:Name="InkBlueButton"
                        x:Uid="Reader_InkBlue"
                        Click="InkColorSwatch_Click"
                        Style="{StaticResource ElliePaletteButtonStyle}"
                        Tag="#1A73E8"
                        AutomationProperties.ItemStatus="Not selected">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="#1A73E8" />
                    </Button>
                    <Border
                        Width="1"
                        Height="24"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        x:Name="InkThinButton"
                        x:Uid="Reader_InkThin"
                        Click="InkThicknessButton_Click"
                        Style="{StaticResource ElliePaletteButtonStyle}"
                        Tag="2"
                        AutomationProperties.ItemStatus="Not selected">
                        <Rectangle
                            Width="20"
                            Height="2"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RadiusX="1"
                            RadiusY="1" />
                    </Button>
                    <Button
                        x:Name="InkMediumButton"
                        x:Uid="Reader_InkMedium"
                        Click="InkThicknessButton_Click"
                        Style="{StaticResource ElliePaletteButtonStyle}"
                        Tag="5"
                        AutomationProperties.ItemStatus="Not selected">
                        <Rectangle
                            Width="20"
                            Height="5"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RadiusX="2"
                            RadiusY="2" />
                    </Button>
                    <Button
                        x:Name="InkThickButton"
                        x:Uid="Reader_InkThick"
                        Click="InkThicknessButton_Click"
                        Style="{StaticResource ElliePaletteButtonStyle}"
                        Tag="9"
                        AutomationProperties.ItemStatus="Not selected">
                        <Rectangle
                            Width="20"
                            Height="9"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RadiusX="4"
                            RadiusY="4" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!--  Eraser options  -->
        <Popup
            x:Name="EraserPalettePopup"
            Canvas.ZIndex="40"
            IsLightDismissEnabled="True">
            <Border
                x:Name="EraserPalette"
                Padding="10,8"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Opacity="0.98">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Margin="2,0,4,0"
                        Opacity="0.75"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Size"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="EraserSmallButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="EraserRadiusButton_Click"
                        Tag="6"
                        ToolTipService.ToolTip="Small">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1" />
                    </Button>
                    <Button
                        x:Name="EraserMediumButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="EraserRadiusButton_Click"
                        Tag="14"
                        ToolTipService.ToolTip="Medium">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1" />
                    </Button>
                    <Button
                        x:Name="EraserLargeButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="EraserRadiusButton_Click"
                        Tag="26"
                        ToolTipService.ToolTip="Large">
                        <Ellipse
                            Width="22"
                            Height="22"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1" />
                    </Button>
                    <Border
                        Width="1"
                        Height="24"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <ToggleButton
                        x:Name="ErasePartialToggle"
                        Height="30"
                        Padding="10,0"
                        Click="ErasePartialToggle_Click"
                        IsChecked="{x:Bind ViewModel.ErasePartially, Mode=OneWay}"
                        ToolTipService.ToolTip="Cut strokes where you erase instead of deleting them whole">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Partial" />
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Popup>

        <!--  Status + busy indicator  -->
        <StackPanel
            MaxWidth="520"
            Margin="0,58,0,0"
            Canvas.ZIndex="40"
            HorizontalAlignment="Center"
            Spacing="8"
            VerticalAlignment="Top">
            <InfoBar
                x:Name="ReaderStatus"
                AutomationProperties.AutomationId="ReaderStatus"
                AutomationProperties.LiveSetting="Polite"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />
            <ProgressRing
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            x:Name="FocusModeAnnouncement"
            Width="1"
            Height="1"
            IsHitTestVisible="False"
            Opacity="0"
            AutomationProperties.LiveSetting="Polite" />
    </Grid>
</Page>
