<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ElliePdf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:ElliePdf.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ElliePdf.ViewModels"
    KeyDown="ReaderPage_KeyDown"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <controls:PdfPageViewer
            x:Name="PageViewer"
            IsChromeless="True"
            PageSource="{x:Bind ViewModel.PageImage, Mode=OneWay}"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.HasDocument), Mode=OneWay}" />

        <Image
            x:Name="PrintTarget"
            Source="{x:Bind ViewModel.PageImage, Mode=OneWay}"
            Visibility="Collapsed" />

        <!-- Empty state: recent files only when nothing is open -->
        <Grid
            Padding="48"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowRecentFiles), Mode=OneWay}">
            <StackPanel
                MaxWidth="420"
                HorizontalAlignment="Center"
                Spacing="16"
                VerticalAlignment="Center">
                <TextBlock
                    HorizontalAlignment="Center"
                    Opacity="0.7"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    Text="Open a PDF to start reading" />
                <ListView
                    IsItemClickEnabled="True"
                    ItemClick="RecentFiles_ItemClick"
                    ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:RecentFileItemViewModel">
                            <TextBlock Padding="8,6" Text="{x:Bind DisplayName, Mode=OneTime}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>

        <!-- Left flyout: page thumbnails -->
        <Border
            x:Name="LeftPanel"
            Width="220"
            HorizontalAlignment="Left"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsThumbnailPanelOpen), Mode=OneWay}">
            <GridView
                Padding="8"
                IsItemClickEnabled="True"
                ItemClick="PageThumbnails_ItemClick"
                ItemsSource="{x:Bind ViewModel.PageThumbnails, Mode=OneWay}"
                SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:PageThumbnailViewModel">
                        <StackPanel Spacing="4" Width="88">
                            <Image Height="112" Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                Opacity="0.8"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Label, Mode=OneWay}" />
                        </StackPanel>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Border>

        <!-- Right flyout: search -->
        <Border
            x:Name="RightPanel"
            Width="280"
            HorizontalAlignment="Right"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0"
            Padding="16"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsSearchPanelOpen), Mode=OneWay}">
            <StackPanel Spacing="12" VerticalAlignment="Top">
                <TextBox
                    x:Name="SearchBox"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="Search in document"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox Content="Match case" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.SearchCommand}" Content="Find" />
                    <Button Command="{x:Bind ViewModel.PreviousSearchMatchCommand}" Content="Previous" />
                    <Button Command="{x:Bind ViewModel.NextSearchMatchCommand}" Content="Next" />
                </StackPanel>
                <TextBlock
                    Opacity="0.8"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <!-- Slim tab strip: only when multiple documents are open -->
        <TabView
            x:Name="DocumentTabs"
            Margin="56,4,56,0"
            VerticalAlignment="Top"
            AddTabButtonClick="DocumentTabs_AddTabButtonClick"
            Background="Transparent"
            CanDragTabs="True"
            CanReorderTabs="True"
            IsAddTabButtonVisible="True"
            TabCloseRequested="DocumentTabs_TabCloseRequested"
            TabWidthMode="SizeToContent"
            SelectionChanged="DocumentTabs_SelectionChanged"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowTabBar), Mode=OneWay}" />

        <!-- Left tool rail -->
        <StackPanel
            Margin="8,0,0,0"
            HorizontalAlignment="Left"
            Spacing="2"
            VerticalAlignment="Center">
            <AppBarButton
                Click="OpenFileButton_Click"
                Icon="OpenFile"
                Label="Open"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Open (Ctrl+O)" />
            <AppBarButton
                Click="CloseDocumentButton_Click"
                Icon="Cancel"
                Label="Close"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Close document (Ctrl+W)"
                Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.HasDocument), Mode=OneWay}" />
            <AppBarButton
                Command="{x:Bind ViewModel.ToggleThumbnailPanelCommand}"
                Icon="ViewAll"
                Label="Pages"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Pages" />
            <AppBarButton
                Command="{x:Bind ViewModel.PreviousPageCommand}"
                Icon="Back"
                Label="Previous"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Previous page" />
            <AppBarButton
                Command="{x:Bind ViewModel.NextPageCommand}"
                Icon="Forward"
                Label="Next"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Next page" />
        </StackPanel>

        <!-- Right tool rail -->
        <StackPanel
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            Spacing="2"
            VerticalAlignment="Center">
            <AppBarButton
                Command="{x:Bind ViewModel.ZoomFitWidthCommand}"
                Icon="FullScreen"
                Label="Fit width"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Fit width" />
            <AppBarButton
                Command="{x:Bind ViewModel.ZoomOutCommand}"
                Icon="Zoom"
                Label="Zoom out"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Zoom out (Ctrl+-)" />
            <AppBarButton
                Command="{x:Bind ViewModel.ZoomInCommand}"
                Icon="Zoom"
                Label="Zoom in"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Zoom in (Ctrl++)" />
            <AppBarButton
                Command="{x:Bind ViewModel.ToggleSearchPanelCommand}"
                Icon="Find"
                Label="Search"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Search (Ctrl+F)" />
            <AppBarButton
                Click="PrintButton_Click"
                Icon="Print"
                Label="Print"
                LabelPosition="Collapsed"
                ToolTipService.ToolTip="Print (Ctrl+P)" />
        </StackPanel>

        <!-- Minimal status + page indicator -->
        <StackPanel
            Margin="0,0,0,8"
            HorizontalAlignment="Center"
            Spacing="4"
            VerticalAlignment="Bottom">
            <InfoBar
                AutomationProperties.AutomationId="ReaderStatus"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />
            <Border
                Padding="10,4"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                CornerRadius="12"
                Opacity="0.92"
                Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.HasDocument), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}" />
                    <ProgressRing
                        Width="14"
                        Height="14"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
