<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ElliePdf.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="using:ElliePdf.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ElliePdf.ViewModels"
    KeyDown="ReaderPage_KeyDown"
    mc:Ignorable="d">

    <Page.Resources>
        <ContentDialog
            x:Name="SignatureDialog"
            Title="Signature"
            AutomationProperties.AutomationId="SignatureDialog"
            PrimaryButtonText="Insert"
            SecondaryButtonText="Cancel">
            <Pivot x:Name="SignaturePivot" Width="440">
                <PivotItem Header="Draw">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Canvas
                                x:Name="SignatureCanvas"
                                Width="400"
                                Height="180"
                                Background="Transparent"
                                AutomationProperties.AutomationId="SignatureCanvas" />
                        </Border>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="BtnClearSignature"
                                AutomationProperties.AutomationId="BtnClearSignature"
                                Content="Clear" />
                            <CheckBox
                                x:Name="SaveSignatureCheckBox"
                                Content="Save for reuse"
                                IsChecked="True" />
                        </StackPanel>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Type">
                    <StackPanel Spacing="10">
                        <TextBox
                            x:Name="TypedSignatureBox"
                            Header="Your name"
                            PlaceholderText="Jane Doe"
                            TextChanged="TypedSignatureBox_TextChanged" />
                        <ComboBox
                            x:Name="TypedSignatureFontBox"
                            Header="Style"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="TypedSignatureFontBox_SelectionChanged" />
                        <Border
                            Height="110"
                            Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Image x:Name="TypedSignaturePreview" Stretch="Uniform" />
                        </Border>
                        <CheckBox
                            x:Name="SaveTypedSignatureCheckBox"
                            Content="Save for reuse"
                            IsChecked="True" />
                    </StackPanel>
                </PivotItem>

                <PivotItem Header="Saved">
                    <Grid>
                        <TextBlock
                            x:Name="NoSavedSignaturesText"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Center"
                            Opacity="0.7"
                            Text="No saved signatures yet."
                            Visibility="Collapsed" />
                        <GridView
                            x:Name="SavedSignaturesGrid"
                            Height="230"
                            IsItemClickEnabled="True"
                            ItemClick="SavedSignaturesGrid_ItemClick"
                            SelectionMode="Single">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SavedSignatureViewModel">
                                    <Grid
                                        Width="180"
                                        Height="100"
                                        Padding="6"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="8">
                                        <Image Source="{x:Bind Preview}" Stretch="Uniform" />
                                        <Button
                                            Width="28"
                                            Height="28"
                                            Padding="0"
                                            Click="DeleteSavedSignature_Click"
                                            HorizontalAlignment="Right"
                                            Tag="{x:Bind Id}"
                                            ToolTipService.ToolTip="Delete"
                                            VerticalAlignment="Top">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </Grid>
                </PivotItem>

                <PivotItem Header="Image">
                    <StackPanel Spacing="10">
                        <TextBlock
                            Opacity="0.75"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="Import a photo or scan. A white background is removed automatically."
                            TextWrapping="Wrap" />
                        <Button Click="ImportSignatureButton_Click" Content="Choose image…" />
                        <Border
                            Height="130"
                            Padding="8"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            CornerRadius="8">
                            <Image x:Name="ImportedSignaturePreview" Stretch="Uniform" />
                        </Border>
                        <CheckBox
                            x:Name="SaveImportedSignatureCheckBox"
                            Content="Save for reuse"
                            IsChecked="True" />
                    </StackPanel>
                </PivotItem>
            </Pivot>
        </ContentDialog>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        AllowDrop="True"
        Background="Transparent"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop"
        PointerMoved="RootGrid_PointerMoved">

        <controls:PdfPageViewer
            x:Name="PageViewer"
            Margin="56,48,56,0"
            Canvas.ZIndex="0"
            ContentBottomInset="112"
            DisplayScale="{x:Bind ViewModel.DisplayScale, Mode=OneWay}"
            IsChromeless="True"
            IsOverlayEnabled="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"
            PageHeightPoints="{x:Bind ViewModel.PageHeightPoints, Mode=OneWay}"
            PageSource="{x:Bind ViewModel.PageImage, Mode=OneWay}"
            SearchHighlights="{x:Bind ViewModel.SearchHighlights, Mode=OneWay}"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.HasDocument), Mode=OneWay}" />

        <Image
            x:Name="PrintTarget"
            Source="{x:Bind ViewModel.PageImage, Mode=OneWay}"
            Visibility="Collapsed" />

        <!--  ═══════════ Empty state ═══════════  -->
        <ScrollViewer
            Canvas.ZIndex="5"
            Padding="48,72,48,24"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowEmptyState), Mode=OneWay}">
            <StackPanel
                MaxWidth="620"
                HorizontalAlignment="Center"
                Spacing="24"
                VerticalAlignment="Center">
                <Image
                    Width="72"
                    Height="72"
                    HorizontalAlignment="Center"
                    Source="ms-appx:///Assets/Brand/elliepdf-logo-master.png" />
                <StackPanel Spacing="4">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="Welcome to ElliePdf" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Opacity="0.7"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="Read, organize, and edit your PDFs" />
                </StackPanel>

                <!--  Drop zone  -->
                <Grid MinWidth="420" Height="156">
                    <Rectangle
                        Fill="{ThemeResource EllieAccentSubtleBrush}"
                        Opacity="0.55"
                        RadiusX="16"
                        RadiusY="16"
                        Stroke="{ThemeResource EllieAccentBrush}"
                        StrokeDashArray="6 4"
                        StrokeThickness="1.5" />
                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="10"
                        VerticalAlignment="Center">
                        <FontIcon
                            FontSize="26"
                            Foreground="{ThemeResource EllieAccentStrongBrush}"
                            Glyph="&#xE8E5;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="Drop a PDF here" />
                        <Button
                            HorizontalAlignment="Center"
                            Click="OpenFileButton_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Open (Ctrl+O)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE838;" />
                                <TextBlock Text="Browse files" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Recent files  -->
                <StackPanel Spacing="8" Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowRecentFiles), Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Opacity="0.7"
                            Glyph="&#xE823;" />
                        <TextBlock Style="{StaticResource EllieSectionHeaderStyle}" Text="Recent" Margin="0" />
                    </StackPanel>
                    <GridView
                        IsItemClickEnabled="True"
                        ItemClick="RecentFiles_ItemClick"
                        ItemsSource="{x:Bind ViewModel.RecentFiles, Mode=OneWay}"
                        SelectionMode="None">
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentFileItemViewModel">
                                <Border
                                    Width="284"
                                    Padding="12,10"
                                    Style="{StaticResource EllieCardStyle}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource EllieIconWellStyle}" VerticalAlignment="Center">
                                            <FontIcon
                                                FontSize="16"
                                                Foreground="{ThemeResource EllieAccentStrongBrush}"
                                                Glyph="&#xE8A5;" />
                                        </Border>
                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                Text="{x:Bind DisplayName}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Opacity="0.6"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Text="{x:Bind FolderName}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--  ═══════════ Pages panel ═══════════  -->
        <Border
            x:Name="ThumbnailsPanel"
            Width="252"
            Margin="14,60,0,126"
            Canvas.ZIndex="10"
            HorizontalAlignment="Left"
            Shadow="{StaticResource EllieShadow}"
            Style="{StaticResource ElliePanelStyle}"
            Translation="0,0,24"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsThumbnailPanelOpen), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10,8,6">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Pages"
                        VerticalAlignment="Center" />
                    <Button
                        Width="32"
                        Height="30"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close pages panel"
                        Command="{x:Bind ViewModel.ToggleThumbnailPanelCommand}"
                        Style="{StaticResource EllieToolButtonStyle}"
                        ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <GridView
                    Grid.Row="1"
                    Padding="12,2,12,12"
                    IsItemClickEnabled="True"
                    ItemClick="PageThumbnails_ItemClick"
                    ItemsSource="{x:Bind ViewModel.PageThumbnails, Mode=OneWay}"
                    SelectionMode="None">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageThumbnailViewModel">
                            <StackPanel Width="96" Spacing="4">
                                <Grid Height="120">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" />
                                    <ProgressRing
                                        HorizontalAlignment="Center"
                                        IsActive="{x:Bind IsLoading, Mode=OneWay}"
                                        VerticalAlignment="Center"
                                        Visibility="{x:Bind IsLoading, Mode=OneWay}" />
                                    <Image
                                        Margin="4"
                                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                                        Stretch="Uniform" />
                                    <Border
                                        BorderBrush="{ThemeResource EllieAccentBrush}"
                                        BorderThickness="2"
                                        CornerRadius="8"
                                        Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(IsSelected), Mode=OneWay}" />
                                </Grid>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Opacity="0.8"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Label, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>
            </Grid>
        </Border>

        <!--  ═══════════ Outline panel ═══════════  -->
        <Border
            x:Name="OutlinePanel"
            Width="288"
            Margin="14,60,0,126"
            Canvas.ZIndex="10"
            HorizontalAlignment="Left"
            Shadow="{StaticResource EllieShadow}"
            Style="{StaticResource ElliePanelStyle}"
            Translation="0,0,24"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsOutlinePanelOpen), Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10,8,6">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Outline"
                        VerticalAlignment="Center" />
                    <Button
                        Width="32"
                        Height="30"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close outline panel"
                        Command="{x:Bind ViewModel.ToggleOutlinePanelCommand}"
                        Style="{StaticResource EllieToolButtonStyle}"
                        ToolTipService.ToolTip="Close">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <ListView
                    Grid.Row="1"
                    Padding="8,0,8,12"
                    IsItemClickEnabled="True"
                    ItemClick="OutlineItems_ItemClick"
                    ItemsSource="{x:Bind ViewModel.OutlineItems, Mode=OneWay}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:OutlineItemViewModel">
                            <TextBlock
                                Margin="{x:Bind IndentMargin, Mode=OneWay}"
                                Padding="4,6"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  ═══════════ Search panel ═══════════  -->
        <Border
            x:Name="SearchPanel"
            Width="316"
            Margin="0,60,14,0"
            Canvas.ZIndex="10"
            HorizontalAlignment="Right"
            Shadow="{StaticResource EllieShadow}"
            Style="{StaticResource ElliePanelStyle}"
            Translation="0,0,24"
            VerticalAlignment="Top"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsSearchPanelOpen), Mode=OneWay}">
            <StackPanel Padding="16,10,16,16" Spacing="10">
                <Grid>
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="Search"
                        VerticalAlignment="Center" />
                    <Button
                        Width="32"
                        Height="30"
                        Margin="0,0,-8,0"
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Close search panel"
                        Command="{x:Bind ViewModel.ToggleSearchPanelCommand}"
                        Style="{StaticResource EllieToolButtonStyle}"
                        ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <TextBox
                    x:Name="SearchBox"
                    KeyDown="SearchBox_KeyDown"
                    PlaceholderText="Find in document"
                    Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Command="{x:Bind ViewModel.SearchCommand}"
                        Content="Find"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button
                        Grid.Column="1"
                        Width="36"
                        AutomationProperties.Name="Previous match"
                        Command="{x:Bind ViewModel.PreviousSearchMatchCommand}"
                        Style="{StaticResource EllieToolButtonStyle}"
                        ToolTipService.ToolTip="Previous match">
                        <FontIcon FontSize="13" Glyph="&#xE70E;" />
                    </Button>
                    <Button
                        Grid.Column="2"
                        Width="36"
                        AutomationProperties.Name="Next match"
                        Command="{x:Bind ViewModel.NextSearchMatchCommand}"
                        Style="{StaticResource EllieToolButtonStyle}"
                        ToolTipService.ToolTip="Next match">
                        <FontIcon FontSize="13" Glyph="&#xE70D;" />
                    </Button>
                </Grid>
                <CheckBox Content="Match case" IsChecked="{x:Bind ViewModel.MatchCase, Mode=TwoWay}" />
                <TextBlock
                    Opacity="0.8"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.SearchStatus, Mode=OneWay}"
                    TextWrapping="WrapWholeWords" />
            </StackPanel>
        </Border>

        <!--  ═══════════ Top-right document commands ═══════════  -->
        <Border
            x:Name="TopCommandBar"
            Margin="0,58,16,0"
            Padding="6,4"
            Canvas.ZIndex="30"
            HorizontalAlignment="Right"
            Shadow="{StaticResource EllieShadow}"
            Style="{StaticResource ElliePillStyle}"
            Translation="0,0,20"
            VerticalAlignment="Top"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowReadToolbar), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="Open"
                    Click="OpenFileButton_Click"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Open (Ctrl+O)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE8E5;" />
                </Button>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="Search"
                    Command="{x:Bind ViewModel.ToggleSearchPanelCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Search (Ctrl+F)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE721;" />
                </Button>
                <Button
                    AutomationProperties.Name="Print"
                    Click="PrintButton_Click"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Print (Ctrl+P)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE749;" />
                </Button>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="Organize pages"
                    Command="{x:Bind ViewModel.OpenOrganizeCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Organize pages">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE8A9;" />
                </Button>
                <Button
                    AutomationProperties.Name="Edit PDF"
                    Command="{x:Bind ViewModel.EnterEditModeCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Edit PDF">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE70F;" />
                </Button>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="More"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="More">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout
                            x:Name="MoreFlyout"
                            Closed="Flyout_Closed"
                            Opening="Flyout_Opening"
                            Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Click="CloseDocumentButton_Click" Text="Close document">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE711;" />
                                </MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAcceleratorTextOverride>Ctrl+W</MenuFlyoutItem.KeyboardAcceleratorTextOverride>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Border>

        <!--  ═══════════ Floating read toolbar ═══════════  -->
        <Border
            x:Name="ReadToolbar"
            Margin="12,12,12,18"
            Canvas.ZIndex="30"
            HorizontalAlignment="Center"
            Shadow="{StaticResource EllieShadow}"
            Style="{StaticResource ElliePillStyle}"
            Translation="0,0,20"
            VerticalAlignment="Bottom"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowReadToolbar), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton
                    AutomationProperties.Name="Pages"
                    Command="{x:Bind ViewModel.ToggleThumbnailPanelCommand}"
                    IsChecked="{x:Bind ViewModel.IsThumbnailPanelOpen, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Pages">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xF0E2;" />
                </ToggleButton>
                <ToggleButton
                    AutomationProperties.Name="Outline"
                    Command="{x:Bind ViewModel.ToggleOutlinePanelCommand}"
                    IsChecked="{x:Bind ViewModel.IsOutlinePanelOpen, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Document outline">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE8FD;" />
                </ToggleButton>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="Previous page"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Previous page">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE76B;" />
                </Button>
                <Button
                    MinWidth="112"
                    AutomationProperties.Name="Go to page"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Go to page">
                    <TextBlock
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <Button.Flyout>
                        <Flyout
                            x:Name="GoToPageFlyout"
                            Closed="Flyout_Closed"
                            Opening="GoToPageFlyout_Opening"
                            Placement="Top">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <NumberBox
                                    x:Name="GoToPageBox"
                                    Width="120"
                                    KeyDown="GoToPageBox_KeyDown"
                                    Minimum="1"
                                    SpinButtonPlacementMode="Compact" />
                                <Button
                                    Click="GoToPageButton_Click"
                                    Content="Go"
                                    Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Bottom" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.Name="Next page"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Next page">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE76C;" />
                </Button>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="Zoom out"
                    Command="{x:Bind ViewModel.ZoomOutCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE71F;" />
                </Button>
                <Button
                    MinWidth="64"
                    AutomationProperties.Name="Zoom level"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Zoom options">
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind ViewModel.ZoomLabel, Mode=OneWay}" />
                    <Button.Flyout>
                        <Flyout
                            x:Name="ZoomFlyout"
                            Closed="Flyout_Closed"
                            Opening="ZoomFlyout_Opening"
                            Placement="Top">
                            <StackPanel Width="248" Spacing="10">
                                <Slider
                                    x:Name="ZoomSlider"
                                    Header="Zoom"
                                    Maximum="400"
                                    Minimum="25"
                                    StepFrequency="5"
                                    ValueChanged="ZoomSlider_ValueChanged" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Click="ZoomPreset_Click"
                                        Content="Fit width"
                                        Tag="fitwidth" />
                                    <Button
                                        Click="ZoomPreset_Click"
                                        Content="Fit page"
                                        Tag="fitpage" />
                                    <Button
                                        Click="ZoomPreset_Click"
                                        Content="100%"
                                        Tag="actual" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button
                    AutomationProperties.Name="Zoom in"
                    Command="{x:Bind ViewModel.ZoomInCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Zoom in (Ctrl++)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE8A3;" />
                </Button>
            </StackPanel>
        </Border>

        <!--  ═══════════ Floating edit toolbar ═══════════  -->
        <Border
            x:Name="EditToolbar"
            Margin="12,12,12,18"
            Canvas.ZIndex="30"
            HorizontalAlignment="Center"
            Shadow="{StaticResource EllieShadow}"
            Style="{StaticResource EllieEditPillStyle}"
            Translation="0,0,20"
            VerticalAlignment="Bottom"
            Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.ShowEditToolbar), Mode=OneWay}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <Button
                    Height="34"
                    Padding="12,0"
                    AutomationProperties.Name="Done editing"
                    Command="{x:Bind ViewModel.ExitEditModeCommand}"
                    Style="{StaticResource AccentButtonStyle}"
                    ToolTipService.ToolTip="Done editing">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="13" Glyph="&#xE73E;" />
                        <TextBlock Text="Done" />
                    </StackPanel>
                </Button>
                <Button
                    AutomationProperties.Name="Save"
                    Click="SaveButton_Click"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Save edits">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE74E;" />
                </Button>
                <Button
                    AutomationProperties.Name="Save as"
                    Click="SaveAsButton_Click"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Save a copy">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE792;" />
                </Button>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <ToggleButton
                    AutomationProperties.Name="Select and move"
                    Command="{x:Bind ViewModel.UseSelectToolCommand}"
                    IsChecked="{x:Bind ViewModel.IsSelectToolActive, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Select and move">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE7C9;" />
                </ToggleButton>
                <ToggleButton
                    x:Name="InkToolButton"
                    AutomationProperties.Name="Ink"
                    Click="InkToolButton_Click"
                    Command="{x:Bind ViewModel.UseInkToolCommand}"
                    IsChecked="{x:Bind ViewModel.IsInkToolActive, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Ink">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE76D;" />
                </ToggleButton>
                <Button
                    AutomationProperties.Name="Add text"
                    Click="AddTextButton_Click"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Add text">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE8D2;" />
                </Button>
                <Button
                    AutomationProperties.Name="Signature"
                    Click="SignatureButton_Click"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Signature">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xEDFB;" />
                </Button>
                <ToggleButton
                    AutomationProperties.Name="Eraser"
                    Command="{x:Bind ViewModel.UseEraserToolCommand}"
                    IsChecked="{x:Bind ViewModel.IsEraserToolActive, Mode=OneWay}"
                    Click="EraserToolButton_Click"
                    x:Name="EraserToolButton"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Eraser">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE75C;" />
                </ToggleButton>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <ToggleButton
                    AutomationProperties.Name="Rectangle"
                    Command="{x:Bind ViewModel.UseRectangleToolCommand}"
                    IsChecked="{x:Bind ViewModel.IsRectangleToolActive, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Rectangle">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE739;" />
                </ToggleButton>
                <ToggleButton
                    AutomationProperties.Name="Ellipse"
                    Command="{x:Bind ViewModel.UseEllipseToolCommand}"
                    IsChecked="{x:Bind ViewModel.IsEllipseToolActive, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Ellipse">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xEA3A;" />
                </ToggleButton>
                <ToggleButton
                    AutomationProperties.Name="Line"
                    Command="{x:Bind ViewModel.UseLineToolCommand}"
                    IsChecked="{x:Bind ViewModel.IsLineToolActive, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Line">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE738;" />
                </ToggleButton>
                <ToggleButton
                    AutomationProperties.Name="Arrow"
                    Command="{x:Bind ViewModel.UseArrowToolCommand}"
                    IsChecked="{x:Bind ViewModel.IsArrowToolActive, Mode=OneWay}"
                    Style="{StaticResource EllieToolToggleStyle}"
                    ToolTipService.ToolTip="Arrow">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE8AD;" />
                </ToggleButton>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="Undo"
                    Click="UndoEditButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanUndoEdit, Mode=OneWay}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Undo edit (Ctrl+Z)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE7A7;" />
                </Button>
                <Button
                    AutomationProperties.Name="Redo"
                    Click="RedoEditButton_Click"
                    IsEnabled="{x:Bind ViewModel.CanRedoEdit, Mode=OneWay}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Redo edit (Ctrl+Y)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE7A6;" />
                </Button>
                <Button
                    AutomationProperties.Name="Delete selected edit"
                    Click="DeleteEditButton_Click"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Delete selected edit">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE74D;" />
                </Button>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="Previous page"
                    Command="{x:Bind ViewModel.PreviousPageCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Previous page">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE76B;" />
                </Button>
                <Border
                    MinWidth="100"
                    Padding="8,0"
                    VerticalAlignment="Center">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
                <Button
                    AutomationProperties.Name="Next page"
                    Command="{x:Bind ViewModel.NextPageCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Next page">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE76C;" />
                </Button>
                <Border Style="{StaticResource EllieDividerStyle}" />
                <Button
                    AutomationProperties.Name="Zoom out"
                    Command="{x:Bind ViewModel.ZoomOutCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Zoom out (Ctrl+-)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE71F;" />
                </Button>
                <Button
                    AutomationProperties.Name="Zoom in"
                    Command="{x:Bind ViewModel.ZoomInCommand}"
                    Style="{StaticResource EllieToolButtonStyle}"
                    ToolTipService.ToolTip="Zoom in (Ctrl++)">
                    <FontIcon Style="{StaticResource EllieToolIconStyle}" Glyph="&#xE8A3;" />
                </Button>
            </StackPanel>
        </Border>

        <!--  Ink palette  -->
        <Popup
            x:Name="InkPalettePopup"
            Canvas.ZIndex="40"
            IsLightDismissEnabled="True">
            <Border
                x:Name="InkPalette"
                Padding="10,8"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Opacity="0.98">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Margin="2,0,4,0"
                        Opacity="0.75"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Ink"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="InkBlackButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="InkColorSwatch_Click"
                        Tag="#000000"
                        ToolTipService.ToolTip="Black">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="Black" />
                    </Button>
                    <Button
                        x:Name="InkRedButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="InkColorSwatch_Click"
                        Tag="#B3261E"
                        ToolTipService.ToolTip="Red">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="#B3261E" />
                    </Button>
                    <Button
                        x:Name="InkBlueButton"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="InkColorSwatch_Click"
                        Tag="#1A73E8"
                        ToolTipService.ToolTip="Blue">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Fill="#1A73E8" />
                    </Button>
                    <Border
                        Width="1"
                        Height="24"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Button
                        x:Name="InkThinButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="InkThicknessButton_Click"
                        Tag="2"
                        ToolTipService.ToolTip="Thin">
                        <Rectangle
                            Width="20"
                            Height="2"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RadiusX="1"
                            RadiusY="1" />
                    </Button>
                    <Button
                        x:Name="InkMediumButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="InkThicknessButton_Click"
                        Tag="5"
                        ToolTipService.ToolTip="Medium">
                        <Rectangle
                            Width="20"
                            Height="5"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RadiusX="2"
                            RadiusY="2" />
                    </Button>
                    <Button
                        x:Name="InkThickButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="InkThicknessButton_Click"
                        Tag="9"
                        ToolTipService.ToolTip="Thick">
                        <Rectangle
                            Width="20"
                            Height="9"
                            Fill="{ThemeResource TextFillColorPrimaryBrush}"
                            RadiusX="4"
                            RadiusY="4" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>

        <!--  Eraser options  -->
        <Popup
            x:Name="EraserPalettePopup"
            Canvas.ZIndex="40"
            IsLightDismissEnabled="True">
            <Border
                x:Name="EraserPalette"
                Padding="10,8"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="20"
                Opacity="0.98">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Margin="2,0,4,0"
                        Opacity="0.75"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Size"
                        VerticalAlignment="Center" />
                    <Button
                        x:Name="EraserSmallButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="EraserRadiusButton_Click"
                        Tag="6"
                        ToolTipService.ToolTip="Small">
                        <Ellipse
                            Width="10"
                            Height="10"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1" />
                    </Button>
                    <Button
                        x:Name="EraserMediumButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="EraserRadiusButton_Click"
                        Tag="14"
                        ToolTipService.ToolTip="Medium">
                        <Ellipse
                            Width="16"
                            Height="16"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1" />
                    </Button>
                    <Button
                        x:Name="EraserLargeButton"
                        Width="34"
                        Height="30"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="2"
                        Click="EraserRadiusButton_Click"
                        Tag="26"
                        ToolTipService.ToolTip="Large">
                        <Ellipse
                            Width="22"
                            Height="22"
                            Stroke="{ThemeResource TextFillColorPrimaryBrush}"
                            StrokeThickness="1" />
                    </Button>
                    <Border
                        Width="1"
                        Height="24"
                        Margin="4,0"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <ToggleButton
                        x:Name="ErasePartialToggle"
                        Height="30"
                        Padding="10,0"
                        Click="ErasePartialToggle_Click"
                        IsChecked="{x:Bind ViewModel.ErasePartially, Mode=OneWay}"
                        ToolTipService.ToolTip="Cut strokes where you erase instead of deleting them whole">
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Partial" />
                    </ToggleButton>
                </StackPanel>
            </Border>
        </Popup>

        <!--  Status + busy indicator  -->
        <StackPanel
            MaxWidth="520"
            Margin="0,58,0,0"
            Canvas.ZIndex="40"
            HorizontalAlignment="Center"
            Spacing="8"
            VerticalAlignment="Top">
            <InfoBar
                AutomationProperties.AutomationId="ReaderStatus"
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />
            <ProgressRing
                Width="20"
                Height="20"
                HorizontalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                Visibility="{x:Bind helpers:VisibilityHelper.FromBoolean(ViewModel.IsBusy), Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
