<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <RootNamespace>ElliePdf</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64' or '$(Platform)' == 'ARM64'">ARM64</PlatformTarget>
    <PlatformTarget Condition="'$(PlatformTarget)' == ''">x64</PlatformTarget>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultLanguage>en-US</DefaultLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ElliePdf.Tests\**" />
    <Compile Remove="ElliePdf.Core\**" />
    <Compile Remove="Benchmark\**" />
    <Compile Remove="eng\**" />
    <Compile Remove="src\**" />
    <Compile Remove="tests\**" />
    <Compile Remove="tools\**" />
    <Content Remove="ElliePdf.Tests\**" />
    <Content Remove="ElliePdf.Core\**" />
    <Content Remove="Benchmark\**" />
    <Content Remove="eng\**" />
    <Content Remove="src\**" />
    <Content Remove="tests\**" />
    <EmbeddedResource Remove="ElliePdf.Tests\**" />
    <EmbeddedResource Remove="ElliePdf.Core\**" />
    <EmbeddedResource Remove="Benchmark\**" />
    <EmbeddedResource Remove="eng\**" />
    <EmbeddedResource Remove="src\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="ElliePdf.Tests\**" />
    <None Remove="ElliePdf.Core\**" />
    <None Remove="Benchmark\**" />
    <None Remove="eng\**" />
    <None Remove="src\**" />
    <None Remove="tests\**" />
    <Page Remove="ElliePdf.Tests\**" />
    <Page Remove="ElliePdf.Core\**" />
    <Page Remove="Benchmark\**" />
    <Page Remove="eng\**" />
    <Page Remove="src\**" />
    <Page Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ElliePdf.Core\ElliePdf.Core.csproj" />
    <ProjectReference Include="src\ElliePdf.Domain\ElliePdf.Domain.csproj" />
    <ProjectReference Include="src\ElliePdf.Application\ElliePdf.Application.csproj" />
    <ProjectReference Include="src\ElliePdf.Diagnostics\ElliePdf.Diagnostics.csproj" />
    <ProjectReference Include="src\ElliePdf.Infrastructure\ElliePdf.Infrastructure.csproj" />
    <ProjectReference Include="src\ElliePdf.Pdf.Contracts\ElliePdf.Pdf.Contracts.csproj" />
    <ProjectReference Include="src\ElliePdf.Pdf.Client\ElliePdf.Pdf.Client.csproj" />
    <ProjectReference Include="src\ElliePdf.Printing\ElliePdf.Printing.csproj" />
    <ProjectReference Include="src\ElliePdf.Rendering\ElliePdf.Rendering.csproj" />
    <ProjectReference Include="src\ElliePdf.Semantics\ElliePdf.Semantics.csproj" />
    <ProjectReference Include="src\ElliePdf.Pdfium.Worker\ElliePdf.Pdfium.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Brand\elliepdf-logo-master.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Release'">True</PublishReadyToRun>
    <PublishTrimmed Condition="'$(Configuration)' == 'Debug'">False</PublishTrimmed>
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">True</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup>
    <PublishAot>true</PublishAot>
    <SelfContained Condition="'$(Configuration)' == 'Release'">true</SelfContained>
  </PropertyGroup>

  <Target Name="CopyPdfWorkerBundle" AfterTargets="Build">
    <ItemGroup>
      <_PdfWorkerBundle Include="$(MSBuildProjectDirectory)\src\ElliePdf.Pdfium.Worker\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\**\*"
                        Condition="'$(RuntimeIdentifier)' != ''" />
      <_PdfWorkerBundle Include="$(MSBuildProjectDirectory)\src\ElliePdf.Pdfium.Worker\bin\$(Platform)\$(Configuration)\$(TargetFramework)\*"
                        Condition="'$(RuntimeIdentifier)' == ''" />
    </ItemGroup>
    <Error Condition="'@(_PdfWorkerBundle)' == ''"
           Text="The isolated PDF worker output was not produced for $(Platform) $(Configuration)." />
    <MakeDir Directories="$(OutDir)PdfWorker" />
    <Copy SourceFiles="@(_PdfWorkerBundle)"
          DestinationFiles="@(_PdfWorkerBundle->'$(OutDir)PdfWorker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Release packaging runs the worker's NativeAOT publish as a separate, deterministic
       step because the worker is intentionally not a managed project reference.  The
       publish target then carries that already-published payload into the app payload. -->
  <PropertyGroup>
    <PdfWorkerPublishDirectory Condition="'$(PdfWorkerPublishDirectory)' == ''">$(MSBuildProjectDirectory)\src\ElliePdf.Pdfium.Worker\bin\$(Platform)\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\publish</PdfWorkerPublishDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(GenerateAppxPackageOnBuild)' == 'true' and Exists('$(PdfWorkerPublishDirectory)')">
    <AppxPackagePayload
      Include="$(PdfWorkerPublishDirectory)\**\*"
      Exclude="$(PdfWorkerPublishDirectory)\**\*.pdb">
      <TargetPath>PdfWorker\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
    </AppxPackagePayload>
  </ItemGroup>
  <Target Name="CopyPdfWorkerBundleToPublish" AfterTargets="ComputeFilesToPublish" Condition="'$(RuntimeIdentifier)' != '' and '$(PublishAot)' == 'true'">
    <ItemGroup>
      <_PdfWorkerPublishFiles Include="$(PdfWorkerPublishDirectory)\**\*" Exclude="$(PdfWorkerPublishDirectory)\**\*.pdb" />
    </ItemGroup>
    <Error Condition="'@(_PdfWorkerPublishFiles)' == ''" Text="NativeAOT PDF worker publish output was not found: $(PdfWorkerPublishDirectory). Publish the worker before publishing the app." />
    <Copy SourceFiles="@(_PdfWorkerPublishFiles)"
          DestinationFiles="@(_PdfWorkerPublishFiles->'$(PublishDir)PdfWorker\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ExcludePrivateSymbolsFromMsix"
          BeforeTargets="_EnsurePdbCmfExeFullPath"
          Condition="'$(AppxPackageIncludePrivateSymbols)' != 'true'">
    <ItemGroup>
      <PDBPayload Remove="@(PDBPayload)" />
    </ItemGroup>
  </Target>

</Project>
