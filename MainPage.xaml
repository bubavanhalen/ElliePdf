<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="NavView"
        AutomationProperties.AutomationId="NavView"
        IsPaneOpen="False"
        PaneDisplayMode="LeftMinimal"
        PaneTitle="ElliePdf"
        SelectionChanged="NavView_SelectionChanged">
        <NavigationView.MenuItems>
            <NavigationViewItem AutomationProperties.AutomationId="NavItemRead" Content="Read" Icon="Document" Tag="read" />
            <NavigationViewItem AutomationProperties.AutomationId="NavItemOrganize" Content="Organize" Icon="Library" Tag="organize" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="ContentFrame" />
    </NavigationView>
</Page>
