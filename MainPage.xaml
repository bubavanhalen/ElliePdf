<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="Transparent"
    mc:Ignorable="d">

    <Grid Background="Transparent">
        <NavigationView
            x:Name="NavView"
            AutomationProperties.AutomationId="NavView"
            AlwaysShowHeader="False"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="LeftMinimal"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent" />
                <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            </NavigationView.Resources>
            <NavigationView.PaneHeader>
                <Border Height="48" />
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem AutomationProperties.AutomationId="NavItemRead" Content="Read" Icon="Document" Tag="read" />
                <NavigationViewItem AutomationProperties.AutomationId="NavItemOrganize" Content="Organize" Icon="Library" Tag="organize" />
                <NavigationViewItem AutomationProperties.AutomationId="NavItemSettings" Content="Settings" Icon="Setting" Tag="settings" />
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="ContentFrame" Background="Transparent" />
        </NavigationView>

        <Border
            x:Name="WindowDragSurface"
            Height="44"
            Margin="320,0,152,0"
            Canvas.ZIndex="40"
            Background="Transparent"
            VerticalAlignment="Top" />

        <StackPanel
            Margin="8,6,0,0"
            Canvas.ZIndex="50"
            HorizontalAlignment="Left"
            Orientation="Horizontal"
            Spacing="4"
            VerticalAlignment="Top">
            <Button
                x:Name="PaneToggleButton"
                Width="36"
                Height="32"
                Padding="0"
                AutomationProperties.Name="Menu"
                Click="PaneToggleButton_Click"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Menu">
                <SymbolIcon Symbol="GlobalNavigationButton" />
            </Button>
            <Button
                x:Name="BackButton"
                Width="36"
                Height="32"
                Padding="0"
                AutomationProperties.Name="Back"
                Click="BackButton_Click"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="Back"
                Visibility="Collapsed">
                <SymbolIcon Symbol="Back" />
            </Button>
        </StackPanel>
    </Grid>
</Page>
