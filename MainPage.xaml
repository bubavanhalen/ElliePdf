<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView x:Name="NavView" PaneDisplayMode="Left" SelectionChanged="NavView_SelectionChanged" AutomationProperties.AutomationId="NavView" PaneTitle="ElliePdf">
        <NavigationView.MenuItems>
            <NavigationViewItem Content="Organize" Icon="Library" AutomationProperties.AutomationId="NavItemOrganize" Tag="organize" />
            <NavigationViewItem Content="Edit" Icon="Edit" AutomationProperties.AutomationId="NavItemEdit" Tag="edit" />
        </NavigationView.MenuItems>
        <Frame x:Name="ContentFrame" AutomationProperties.AutomationId="ContentFrame" />
    </NavigationView>
</Page>
