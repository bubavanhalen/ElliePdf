<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource EllieShellBrush}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource EllieShellBrush}"
            BorderBrush="{ThemeResource EllieBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="148" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="12,0,18,0"
                    Orientation="Horizontal"
                    Spacing="9"
                    VerticalAlignment="Center">
                    <Button
                        x:Name="BackButton"
                        AutomationProperties.Name="Back to document"
                        Click="BackButton_Click"
                        Style="{StaticResource EllieIconButtonStyle}"
                        ToolTipService.ToolTip="Back to document"
                        Visibility="Collapsed">
                        <SymbolIcon Symbol="Back" />
                    </Button>
                    <Border
                        Width="28"
                        Height="28"
                        Background="{ThemeResource EllieAccentSubtleBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource EllieAccentBrush}"
                            Glyph="&#xE8A5;" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Ellie PDF" />
                </StackPanel>

                <Border
                    x:Name="WindowDragSurface"
                    Grid.Column="1"
                    Background="Transparent" />

                <StackPanel
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
                    <Button
                        AutomationProperties.Name="Organize pages"
                        Click="OrganizeButton_Click"
                        Style="{StaticResource EllieIconButtonStyle}"
                        ToolTipService.ToolTip="Organize pages">
                        <SymbolIcon Symbol="Library" />
                    </Button>
                    <Button
                        AutomationProperties.Name="Settings"
                        Click="SettingsButton_Click"
                        Style="{StaticResource EllieIconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <SymbolIcon Symbol="Setting" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Frame
            x:Name="ContentFrame"
            Grid.Row="1"
            AutomationProperties.AutomationId="ContentFrame"
            Background="Transparent" />
    </Grid>
</Page>
