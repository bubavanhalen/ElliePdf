<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.Pages.OrganizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:ElliePdf.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            Text="Organize"
            Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar
            Grid.Row="1"
            x:Name="StatusInfoBar"
            AutomationProperties.AutomationId="OrganizeStatus"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <Grid Grid.Row="2" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <CommandBar
                AutomationProperties.AutomationId="OrganizeCommandBar"
                Background="Transparent"
                DefaultLabelPosition="Right">
                <AppBarButton
                    x:Name="ImportButton"
                    AutomationProperties.AutomationId="BtnImport"
                    Click="ImportButton_Click"
                    Icon="OpenFile"
                    Label="Import" />
                <AppBarButton
                    x:Name="AddButton"
                    AutomationProperties.AutomationId="BtnAdd"
                    Click="AddButton_Click"
                    Icon="Add"
                    Label="Add files" />
                <AppBarButton
                    x:Name="SaveButton"
                    AutomationProperties.AutomationId="BtnSave"
                    Click="SaveButton_Click"
                    Icon="Save"
                    Label="Save" />
                <AppBarButton
                    x:Name="MergeButton"
                    AutomationProperties.AutomationId="BtnMerge"
                    Click="MergeButton_Click"
                    Icon="Copy"
                    Label="Export" />
                <AppBarSeparator />
                <AppBarButton
                    x:Name="BackToDocumentButton"
                    AutomationProperties.AutomationId="BtnBackToDocument"
                    Click="BackToDocumentButton_Click"
                    Icon="Document"
                    Label="Back to document" />
            </CommandBar>

            <GridView
                x:Name="ThumbnailGrid"
                Grid.Row="1"
                AutomationProperties.AutomationId="ThumbnailGrid"
                AllowDrop="True"
                CanDragItems="True"
                CanReorderItems="True"
                IsItemClickEnabled="True"
                ItemClick="ThumbnailGrid_ItemClick"
                ItemsSource="{x:Bind ViewModel.Pages, Mode=OneWay}"
                SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:DocumentItemViewModel">
                        <Border
                            Width="192"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <Image
                                        Height="220"
                                        Source="{x:Bind Thumbnail, Mode=OneWay}"
                                        Stretch="Uniform" />
                                </Border>

                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind DisplayName, Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SourceLabel, Mode=OneWay}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                                    <Button
                                        AutomationProperties.AutomationId="BtnDeletePage"
                                        Click="DeleteButton_Click"
                                        Content="Delete"
                                        ToolTipService.ToolTip="Delete page from the working document" />
                                    <Button
                                        AutomationProperties.AutomationId="BtnRotatePage"
                                        Click="RotateButton_Click"
                                        Content="Rotate"
                                        ToolTipService.ToolTip="Rotate page clockwise" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
