<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ElliePdf.Pages.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ElliePdf.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ContentDialog
            x:Name="SignatureDialog"
            Title="Capture Signature"
            PrimaryButtonText="OK"
            SecondaryButtonText="Cancel"
            AutomationProperties.AutomationId="SignatureDialog">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4" Padding="8">
                    <Canvas x:Name="SignatureCanvas" Width="400" Height="200" AutomationProperties.AutomationId="SignatureCanvas" />
                </Border>
                <Button x:Name="BtnClearSignature" Grid.Row="1" Content="Clear" HorizontalAlignment="Left" Margin="0,8,0,0" AutomationProperties.AutomationId="BtnClearSignature" />
            </Grid>
        </ContentDialog>
    </Page.Resources>

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.DocumentTitle, Mode=OneWay}" />

        <InfoBar
            Grid.Row="1"
            IsClosable="True"
            IsOpen="{x:Bind ViewModel.IsStatusOpen, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.StatusSeverity, Mode=OneWay}" />

        <CommandBar Grid.Row="2" Background="Transparent" DefaultLabelPosition="Right">
            <AppBarButton Command="{x:Bind ViewModel.SaveCommand}" Icon="Save" Label="Save" />
            <AppBarButton Command="{x:Bind ViewModel.SaveAsCommand}" Icon="Copy" Label="Save As" />
            <AppBarSeparator />
            <AppBarButton Command="{x:Bind ViewModel.PreviousPageCommand}" Icon="Back" Label="Previous" />
            <AppBarButton Command="{x:Bind ViewModel.NextPageCommand}" Icon="Forward" Label="Next" />
            <AppBarSeparator />
            <AppBarButton Command="{x:Bind ViewModel.ToggleInkModeCommand}" Icon="Edit" Label="Ink" />
            <AppBarButton Click="AddTextButton_Click" Icon="Font" Label="Add text" />
            <AppBarButton Click="SignatureButton_Click" Icon="Contact" Label="Signature" />
            <AppBarSeparator />
            <AppBarButton Command="{x:Bind ViewModel.OpenReadCommand}" Icon="Document" Label="Read" />
        </CommandBar>

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="{x:Bind ViewModel.PageLabel, Mode=OneWay}" />

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid
                    HorizontalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    SizeChanged="PageHost_SizeChanged">
                    <Image
                        x:Name="PageImage"
                        Stretch="None"
                        Source="{x:Bind ViewModel.PageImage, Mode=OneWay}" />
                    <Canvas
                        x:Name="OverlayCanvas"
                        PointerMoved="OverlayCanvas_PointerMoved"
                        PointerPressed="OverlayCanvas_PointerPressed"
                        PointerReleased="OverlayCanvas_PointerReleased" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
